[Unit]
Description=Left suction RealSense D405 RGB-D service
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/mnt/data/erazer/left_suction/d405_service
ExecStart=/home/erazer/Seldon/keyboard_cockpit/.venv/bin/python -u /mnt/data/erazer/left_suction/d405_service/service.py
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
